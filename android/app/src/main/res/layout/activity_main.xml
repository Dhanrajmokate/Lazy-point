<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1117"
    android:padding="12dp">

    <!-- Auto-Discovery Banner -->
    <LinearLayout
        android:id="@+id/layoutDiscovery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#161B22"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tvDiscoveryStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔍 Searching for PC on Wi-Fi..."
            android:textColor="#58A6FF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnDevicesList"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="📋 Devices"
            android:textSize="10sp"
            android:backgroundTint="#21262D"
            android:textColor="#58A6FF"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnForget"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Forget"
            android:textSize="10sp"
            android:visibility="gone"
            android:backgroundTint="#21262D"
            android:textColor="#F85149" />
    </LinearLayout>

    <!-- Connection Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etIp"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.6"
            android:hint="PC IP (Auto-filled)"
            android:textColorHint="#6E7681"
            android:textColor="#FFFFFF"
            android:background="#161B22"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:textSize="14sp"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/etPin"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.1"
            android:layout_marginStart="6dp"
            android:hint="8-digit PIN"
            android:textColorHint="#6E7681"
            android:textColor="#FFFFFF"
            android:background="#161B22"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:textSize="14sp"
            android:maxLength="8"
            android:inputType="number" />

        <Button
            android:id="@+id/btnScanQr"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:text="📷 QR"
            android:textSize="12sp"
            android:backgroundTint="#1F6FEB"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:text="Connect"
            android:textSize="13sp"
            android:backgroundTint="#238636"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Status Text -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Not connected"
        android:textColor="#8B949E"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginVertical="6dp" />

    <!-- Cursor Sensitivity Controller -->
    <LinearLayout
        android:id="@+id/layoutSensitivity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#161B22"
        android:padding="10dp"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvSensitivityLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚡ Cursor Sensitivity: 1.0x"
                android:textColor="#58A6FF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Precise ↔ Fast"
                android:textColor="#8B949E"
                android:textSize="11sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/sbSensitivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="280"
            android:progress="80"
            android:progressTint="#58A6FF"
            android:thumbTint="#58A6FF"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- Touchpad View (Primary Surface) -->
    <FrameLayout
        android:id="@+id/viewTouchpad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="visible"
        android:background="#161B22">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📱 Touchpad Surface\n\n• Slide finger to move cursor\n• Tap for Left Click\n• 2-Finger Tap for Right Click"
            android:textColor="#484F58"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp"
            android:gravity="center"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- Left & Right Click Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btnLeftClick"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="LEFT CLICK"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#21262D"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnRightClick"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="RIGHT CLICK"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#21262D"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Media & Quick Keys Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/btnKeyVolDown"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🔉 -"
            android:textSize="11sp"
            android:backgroundTint="#21262D"
            android:textColor="#58A6FF" />

        <Button
            android:id="@+id/btnKeyVolUp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:text="🔊 +"
            android:textSize="11sp"
            android:backgroundTint="#21262D"
            android:textColor="#58A6FF" />

        <Button
            android:id="@+id/btnKeyPlayPause"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:text="⏯️ Play"
            android:textSize="11sp"
            android:backgroundTint="#21262D"
            android:textColor="#58A6FF" />

        <Button
            android:id="@+id/btnKeyMute"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:text="🔇 Mute"
            android:textSize="11sp"
            android:backgroundTint="#21262D"
            android:textColor="#8B949E" />

        <Button
            android:id="@+id/btnKeyTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.9"
            android:layout_marginStart="3dp"
            android:text="Tab"
            android:textSize="11sp"
            android:backgroundTint="#21262D"
            android:textColor="#C9D1D9" />

        <Button
            android:id="@+id/btnKeyEsc"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.9"
            android:layout_marginStart="3dp"
            android:text="Esc"
            android:textSize="11sp"
            android:backgroundTint="#21262D"
            android:textColor="#F85149" />
    </LinearLayout>

    <!-- Navigation & Arrow Keys Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <Button
            android:id="@+id/btnKeySpace"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:text="Space"
            android:textSize="11sp"
            android:backgroundTint="#21262D"
            android:textColor="#C9D1D9" />

        <Button
            android:id="@+id/btnKeyBackspace"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.1"
            android:layout_marginStart="3dp"
            android:text="⌫ Del"
            android:textSize="11sp"
            android:backgroundTint="#21262D"
            android:textColor="#C9D1D9" />

        <Button
            android:id="@+id/btnKeyEnter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.1"
            android:layout_marginStart="3dp"
            android:text="⏎ Enter"
            android:textSize="11sp"
            android:backgroundTint="#1F6FEB"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnKeyLeft"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.9"
            android:layout_marginStart="3dp"
            android:text="◀"
            android:textSize="12sp"
            android:backgroundTint="#21262D"
            android:textColor="#58A6FF" />

        <Button
            android:id="@+id/btnKeyUp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.9"
            android:layout_marginStart="3dp"
            android:text="▲"
            android:textSize="12sp"
            android:backgroundTint="#21262D"
            android:textColor="#58A6FF" />

        <Button
            android:id="@+id/btnKeyDown"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.9"
            android:layout_marginStart="3dp"
            android:text="▼"
            android:textSize="12sp"
            android:backgroundTint="#21262D"
            android:textColor="#58A6FF" />

        <Button
            android:id="@+id/btnKeyRight"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.9"
            android:layout_marginStart="3dp"
            android:text="▶"
            android:textSize="12sp"
            android:backgroundTint="#21262D"
            android:textColor="#58A6FF" />
    </LinearLayout>

    <!-- Text Typing Bar with Keyboard Launcher -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/btnShowKeyboard"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:text="⌨️"
            android:textSize="16sp"
            android:backgroundTint="#21262D"
            android:padding="0dp"
            android:textColor="#FFFFFF" />

        <EditText
            android:id="@+id/etTextInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:hint="Type &amp; press Enter to send..."
            android:textColorHint="#6E7681"
            android:textColor="#FFFFFF"
            android:background="#161B22"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:textSize="13sp"
            android:inputType="text|textCapSentences"
            android:imeOptions="actionSend" />

        <Button
            android:id="@+id/btnSendText"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:text="Send"
            android:textSize="12sp"
            android:backgroundTint="#238636"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</LinearLayout>
